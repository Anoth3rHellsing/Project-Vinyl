<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProjectVinyl.ViewModels"
             x:Class="ProjectVinyl.Views.VinylCreatorView"
             x:DataType="vm:VinylCreatorViewModel">

    <Border Classes="card" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
            <!-- Header -->
            <TextBlock Text="Vinyl Creator" Classes="heading" HorizontalAlignment="Center" />
            <TextBlock Text="Download audio from YouTube to your local library" Classes="subtitle"
                       HorizontalAlignment="Center" TextAlignment="Center" />

            <!-- URL Input -->
            <TextBox PlaceholderText="Paste YouTube URL here..."
                     Text="{Binding UrlInput}"
                     IsEnabled="{Binding !IsDownloading}" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="⬇ Download" Command="{Binding DownloadCommand}"
                        MinWidth="160" />
                <Button Content="Cancel" Classes="ghost"
                        Command="{Binding CancelDownloadCommand}"
                        IsVisible="{Binding IsDownloading}" />
            </StackPanel>

            <!-- Progress -->
            <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                         IsVisible="{Binding IsDownloading}" />

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" Classes="body"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- Open Library Folder -->
            <Button Content="📂 Open Library Folder" Classes="ghost"
                    Command="{Binding OpenLibraryFolderCommand}"
                    HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>